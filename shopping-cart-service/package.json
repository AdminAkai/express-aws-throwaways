{
  "name": "shopping-cart-service",
  "version": "0.1.0",
  "private": true,
  "description": "Throwaway ecommerce shopping cart API - TypeScript/Express, packaged for AWS Lambda behind API Gateway HTTP API, backed by DynamoDB, deployed with plain CloudFormation.",
  "main": "dist/lambda.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "build:lambda": "node scripts/build-lambda.mjs",
    "test": "jest",
    "local:db:up": "docker compose up -d dynamodb-local",
    "local:db:down": "docker compose down",
    "local:db:create-table": "bash scripts/create-local-table.sh",
    "package": "npm run build:lambda && cd build && zip -r ../build/lambda.zip lambda.js && cd ..",
    "deploy": "bash infra/deploy.sh",
    "destroy": "bash infra/destroy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.23.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
