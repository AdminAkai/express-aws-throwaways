# Copy to .env for local development

# Port for the local Express server
PORT=3000

# DynamoDB table name
CART_TABLE_NAME=CartItems-dev

# When set, the app talks to DynamoDB Local instead of real AWS
# (used automatically by `npm run local:db:up`)
DYNAMODB_ENDPOINT=http://localhost:8000

# Only needed for DynamoDB Local - it ignores these values but the SDK requires them to be present
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
